{
    "files.autoSave": "onFocusChange",
    "files.autoSaveDelay": 10,
    // CodeChecker Integration
    "codechecker.backend.compilationDatabasePath": "${workspaceFolder}/build/compile_commands.json",
    "codechecker.backend.outputFolder": "${workspaceFolder}/.codechecker",
    "codechecker.analyze.arguments": "--ctu --enable=all",
    "codechecker.analyze.threadCount": 8,
    "codechecker.log.buildCommand": "make -j$(nproc)",
    // SEP Engine Project Settings
    "clangd.arguments": [
        "--header-insertion=iwyu",
        "--completion-style=detailed",
        "--function-arg-placeholders",
        "--fallback-style=llvm",
        "-j=8"
    ],
    // File Associations
    "files.associations": {
        "*.cu": "cuda-cpp",
        "*.cuh": "cuda-cpp",
        "*.hpp": "cpp",
        "*.mdc": "markdown"
    },
    // Exclude and Search Settings
    "files.exclude": {
        "out": false,
        "dist": false,
        "build/CMakeFiles": true,
        "cycles-build": true,
        "cycles-install": true,
        "**/.git": true,
        "**/.DS_Store": true
    },
    "search.exclude": {
        "out": true,
        "dist": true,
        "build": true,
        "cycles-build": true,
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true
    },
    // Editor Settings for SEP Project
    "editor.formatOnSave": true,
    "[cpp]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[cuda-cpp]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    // TypeScript Settings
    "typescript.tsc.autoDetect": "off",
    // Terminal Settings for Development
    "terminal.integrated.env.linux": {
        "SEP_WORKSPACE": "${workspaceFolder}",
        "SEP_BUILD_DIR": "${workspaceFolder}/build",
        "CODECHECKER_PORT": "8001",
        "OLLAMA_URL": "http://localhost:11434",
        "OLLAMA_MODEL": "mxbai-embed-large"
    },
    "codechecker.log.arguments": "",
}