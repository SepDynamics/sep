{
  "api": {
    "host": "127.0.0.1",
    "port": 8080,
    "max_connections": 1000,
    "timeout_ms": 5000,
    "threads": 4,
    "keep_alive_timeout_ms": 15000,
    "log_level": "info",
    "enable_metrics": true,
    "max_batch_size": 1024,
    "cors": {
      "enabled": false,
      "allowed_origins": "*"
    },
    "rate_limit": {
      "enabled": true,
      "rpm": 60
    },
    "logging": {
      "log_requests": true,
      "log_responses": false,
      "log_file": "api.log",
      "max_file_size": 10485760,
      "max_files": 5,
      "level": "info"
    },
    "ollama": {
      "host": "",
      "model": ""
    },
    "base_coherence": 1.0,
    "context_weight": 0.0,
    "state_weight": 1.0,
    "superposition_states": 1,
    "response_modulation": {
      "enabled": true,
      "coherence_threshold": 0.7,
      "simplify_low_coherence": true,
      "max_detail_level": 3
    }
  },
  "window": {
    "title": "SEP Workbench",
    "width": 1280,
    "height": 720,
    "fullscreen": false,
    "vsync": true
  },
  "engine": {
    "cuda_enabled": false,
    "metrics_enabled": false,
    "semantic": {
      "embedding_dimensions": 512,
      "coherence_threshold": 0.7,
      "enable_adaptive_processing": true,
      "max_batch_size": 1024
    },
    "analytics": {
      "enable_profiling": false,
      "track_memory_usage": true,
      "collect_metrics": true,
      "history_size": 1000,
      "sampling_rate": 0.1
    },
    "logging": {
      "level": "info",
      "log_dir": "logs",
      "log_file": "sep.log",
      "console_output": true,
      "file_output": true,
      "json_format": false,
      "max_file_size": 10485760,
      "max_files": 5,
      "flush_interval": 1,
      "pattern": "%Y-%m-%d %H:%M:%S.%e [%l] %v",
      "async": true,
      "queue_size": 8192
    },
    "cuda": {
      "use_gpu": true,
      "max_memory_mb": 8192,
      "batch_size": 1024,
      "gpu_memory_limit": 0.9,
      "enable_profiling": false,
      "warp_tile_size": 32,
      "coherence_block_size": 256,
      "similarity_grid_dim": 32,
      "enable_phase_modulation": false
    }
  },
  "genesis_pattern": {
    "initial_pattern": {
      "dimensions": [
        10,
        10,
        10
      ],
      "evolution_rate": 0.5,
      "coherence_threshold": 0.3
    },
    "evolution": {
      "rate_multiplier": 1.0,
      "iterations_per_frame": 1,
      "rate_step": 1.2,
      "min_rate": 0.1,
      "max_rate": 2.0
    },
    "visualization": {
      "coherence_threshold": 0.1,
      "color_mode": "coherence",
      "emission_mode": "standard",
      "roughness_mode": "smooth"
    },
    "controls": {
      "rotation_sensitivity": 0.01,
      "zoom_sensitivity": 0.01,
      "min_zoom": 0.1,
      "max_zoom": 10.0
    }
  },
  "audio_visualizer": {
    "input": {
      "device": "default",
      "sample_rate": 44100,
      "buffer_size": 1024,
      "fft_size": 2048
    },
    "pattern_mapping": {
      "frequency_scale": 1.0,
      "amplitude_scale": 1.0,
      "evolution_sensitivity": 0.5
    }
  },
  "memory_garden": {
    "layout": {
      "stm_radius": 1.0,
      "mtm_radius": 2.0,
      "ltm_radius": 3.0
    },
    "visualization": {
      "show_connections": true,
      "connection_opacity": 0.5,
      "pattern_scale": 1.0
    }
  },
  "flocking": {
    "agent_count": 50,
    "neighbor_radius": 0.2,
    "max_speed": 0.05
  },
  "renderer": {
    "cycles": {
      "samples": 64,
      "denoising": true,
      "device": "CPU"
    }
  }
}