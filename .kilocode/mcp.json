{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {
        "DEFAULT_MINIMUM_TOKENS": ""
      },
      "alwaysAllow": [
        "get-library-docs",
        "resolve-library-id"
      ],
      "timeout": 15,
      "disabledTools": [
        "resolve-library-id",
        "get-library-docs"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/sep"
      ],
      "alwaysAllow": [
        "read_file",
        "read_multiple_files",
        "write_file",
        "edit_file",
        "create_directory",
        "list_directory",
        "list_directory_with_sizes",
        "directory_tree",
        "move_file",
        "list_allowed_directories",
        "get_file_info",
        "search_files"
      ],
      "timeout": 15,
      "disabledTools": [
        "read_file",
        "read_multiple_files",
        "edit_file",
        "write_file",
        "list_directory_with_sizes",
        "list_directory",
        "create_directory",
        "search_files",
        "directory_tree",
        "move_file",
        "get_file_info",
        "list_allowed_directories"
      ]
    },
    "sequentialthinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "alwaysAllow": [
        "sequentialthinking"
      ],
      "timeout": 15,
      "disabledTools": [
        "sequentialthinking"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "alwaysAllow": [
        "create_entities",
        "create_relations",
        "add_observations",
        "delete_observations",
        "delete_entities",
        "delete_relations",
        "read_graph",
        "search_nodes",
        "open_nodes"
      ],
      "timeout": 15,
      "disabledTools": [
        "create_entities",
        "create_relations",
        "add_observations",
        "delete_entities",
        "delete_observations",
        "delete_relations",
        "read_graph",
        "search_nodes",
        "open_nodes"
      ]
    },
    "adaptive-bot": {
      "command": "node",
      "args": [
        "/home/ajn/.local/share/Kilo-Code/MCP/adaptive-bot/build/index.js"
      ],
      "env": {
        "WORKSPACE_DIR": "${workspaceFolder}",
        "SEP_ENGINE_URL": "http://localhost:8080",
        "SEP_CONFIG_FILE": "${workspaceFolder}/config/default.json",
        "REDIS_URL": "redis://localhost:6379",
        "LOG_LEVEL": "DEBUG",
        "METRICS_ENABLED": "1"
      },
      "alwaysAllow": [
        "monitor_patterns",
        "get_insights",
        "track_evolution",
        "process_context",
        "analyze_context",
        "evolve_patterns",
        "analyze_patterns",
        "bridge_patterns",
        "transform_patterns",
        "process_patterns",
        "store_patterns"
      ],
      "timeout": 15,
      "description": "Adaptive bot integrating pattern monitoring, context processing, and evolution capabilities with SEP Engine",
      "disabledTools": [
        "get_insights",
        "monitor_patterns",
        "analyze_patterns",
        "evolve_patterns",
        "analyze_context",
        "process_context",
        "track_evolution",
        "store_patterns",
        "process_patterns",
        "transform_patterns",
        "bridge_patterns"
      ]
    }
  }
}