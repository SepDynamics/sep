{
  "mcpServers": {
    "sep-codebase-search": {
      "command": "node",
      "args": [
        "${workspaceFolder}/mcp-tool/dist/index.js"
      ],
      "env": {
        "WORKSPACE_DIR": "${workspaceFolder}",
        "SEP_ENGINE_URL": "http://localhost:8080",
        "REDIS_URL": "redis://localhost:6379",
        "LOG_LEVEL": "INFO"
      },
      "alwaysAllow": [
        "codebase_search"
      ],
      "timeout": 15,
      "description": "SEP Engine codebase search tool for semantic code search"
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {
        "DEFAULT_MINIMUM_TOKENS": ""
      },
      "alwaysAllow": [
        "get-library-docs",
        "resolve-library-id"
      ],
      "timeout": 15
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/sep"
      ],
      "alwaysAllow": [
        "read_file",
        "read_multiple_files",
        "write_file",
        "edit_file",
        "create_directory",
        "list_directory",
        "list_directory_with_sizes",
        "directory_tree",
        "move_file",
        "list_allowed_directories",
        "get_file_info",
        "search_files"
      ],
      "timeout": 15
    },
    "sequentialthinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "alwaysAllow": [
        "sequentialthinking"
      ],
      "timeout": 15
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "alwaysAllow": [
        "create_entities",
        "create_relations",
        "add_observations",
        "delete_observations",
        "delete_entities",
        "delete_relations",
        "read_graph",
        "search_nodes",
        "open_nodes"
      ],
      "timeout": 15
    },
    "adaptive-bot": {
      "command": "node",
      "args": [
        "/home/ajn/.local/share/Kilo-Code/MCP/adaptive-bot/build/index.js"
      ],
      "env": {
        "WORKSPACE_DIR": "${workspaceFolder}",
        "SEP_ENGINE_URL": "http://localhost:8080",
        "SEP_CONFIG_FILE": "${workspaceFolder}/config/default.json",
        "REDIS_URL": "redis://localhost:6379",
        "LOG_LEVEL": "DEBUG",
        "METRICS_ENABLED": "1"
      },
      "alwaysAllow": [
        "monitor_patterns",
        "get_insights",
        "track_evolution",
        "process_context",
        "analyze_context",
        "evolve_patterns",
        "analyze_patterns",
        "bridge_patterns",
        "transform_patterns",
        "process_patterns",
        "store_patterns"
      ],
      "timeout": 15,
      "description": "Adaptive bot integrating pattern monitoring, context processing, and evolution capabilities with SEP Engine"
    },
    "code-analyzer": {
      "command": "node",
      "args": [
        "/home/ajn/.local/share/Kilo-Code/MCP/code-analyzer/build/index.js"
      ],
      "env": {
        "CODECHECKER_PORT": "8001",
        "OLLAMA_URL": "http://localhost:11434",
        "OLLAMA_MODEL": "mxbai-embed-large",
        "WORKSPACE_DIR": "${workspaceFolder}",
        "SEP_BUILD_DIR": "${workspaceFolder}/build",
        "SEP_CONFIG_FILE": "${workspaceFolder}/config/default.json"
      },
      "alwaysAllow": [
        "cycles_render",
        "check_status",
        "run_analysis",
        "store_results",
        "semantic_search",
        "analyze_issues",
        "run_vscode_task",
        "analyze"
      ],
      "timeout": 15,
      "description": "SEP Engine code analysis server with CodeChecker integration and Cycles rendering support"
    }
  }
}