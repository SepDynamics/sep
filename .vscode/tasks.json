{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Auto Build",
      "type": "shell",
      "command": "make",
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": ["$nvcc"]
    },
    {
      "label": "Configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DCMAKE_BUILD_TYPE=Release"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": ["$nvcc"]
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "make",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": ["Configure"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": ["$nvcc"]
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "rm",
      "args": ["-rf", "build"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "Rebuild",
      "dependsOrder": "sequence",
      "dependsOn": ["Clean", "Configure", "Build"],
      "group": "build"
    }
  ]
}