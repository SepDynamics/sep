from mcp.server import MCPServer
from mcp.tools import Tool, ToolInput, ToolOutput
import subprocess
import json

server = MCPServer("build_analyzer")

@server.tool(
    name="analyze_build",
    description="Run build.sh and analyze output for errors",
    input_schema={
        "type": "object",
        "properties": {
            "verbose": {
                "type": "boolean",
                "description": "Whether to include full build output",
                "default": False
            }
        },
        "additionalProperties": False
    },
    output_schema={
        "type": "object",
        "properties": {
            "status": {
                "type": "string",
                "enum": ["success", "error"],
                "description": "Build analysis status"
            },
            "error_count": {
                "type": "integer",
                "description": "Number of unique errors found"
            },
            "errors": {
                "type": "array",
                "items": {"type": "string"},
                "description": "List of unique error messages"
            },
            "full_output": {
                "type": "string",
                "description": "Complete build output if verbose=true"
            }
        },
        "required": ["status", "error_count", "errors"]
    }
)
async def analyze_build(input: ToolInput) -> ToolOutput:
    """Run build.sh, analyze output, and return structured error information."""
    try:
        # Run build script
        result = subprocess.run(
            ['./build.sh'],
            capture_output=True,
            text=True,
            cwd='/sep'
        )
        
        # Combine stdout and stderr
        output = result.stdout + result.stderr
        
        # Extract error lines
        errors = [
            line.strip() 
            for line in output.splitlines() 
            if 'error' in line.lower()
        ]
        
        # Remove duplicates while preserving order
        unique_errors = list(dict.fromkeys(errors))
        
        # Prepare response
        response = {
            "status": "error" if unique_errors else "success",
            "error_count": len(unique_errors),
            "errors": unique_errors
        }
        
        # Add full output if verbose mode
        if input.data.get("verbose", False):
            response["full_output"] = output
            
        return ToolOutput(data=response)
        
    except Exception as e:
        return ToolOutput(
            data={
                "status": "error",
                "error_count": 1,
                "errors": [f"Failed to run build: {str(e)}"]
            }
        )

if __name__ == "__main__":
    server.run()