{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run SEP",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/sep_app",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build"
        },
        {
            "name": "Run Blender-SEP",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/cmake-make/bin/blender",
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug Tests",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/sep_tests",
            "args": ["--gtest_break_on_failure"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build"
        },
        {
			"name": "Run Extension",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": ["--extensionDevelopmentPath=${workspaceFolder}/src"],
			"sourceMaps": true,
			"outFiles": ["${workspaceFolder}/dist/**/*.js"],
			"preLaunchTask": "${defaultBuildTask}",
			"env": {
				"NODE_ENV": "development",
				"VSCODE_DEBUG_MODE": "true"
			},
			"resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"],
			"presentation": {
				"hidden": false,
				"group": "tasks",
				"order": 1
			}
		}
    ]
}