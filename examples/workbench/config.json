{
  "window": {
    "title": "SEP Workbench",
    "width": 1280,
    "height": 720,
    "fullscreen": false,
    "vsync": true
  },
  "engine": {
    "cuda_enabled": true,
    "metrics_enabled": true,
    "log_level": "info"
  },
  "demos": {
    "genesis_pattern": {
      "initial_pattern": {
        "dimensions": [
          3,
          3,
          3
        ],
        "evolution_rate": 0.1,
        "coherence_threshold": 0.5
      },
      "visualization": {
        "color_mode": "coherence",
        "emission_mode": "stability",
        "roughness_mode": "energy",
        "coherence_threshold": 0.1
      },
      "evolution": {
        "rate_multiplier": 1.0,
        "rate_step": 1.1,
        "max_rate": 2.0,
        "min_rate": 0.01,
        "iterations_per_frame": 1
      },
      "controls": {
        "rotation_sensitivity": 0.005,
        "zoom_sensitivity": 0.01,
        "min_zoom": 0.5,
        "max_zoom": 5.0
      },
      "save_state": {
        "evolution_rate": 0.1,
        "coherence_threshold": 0.5,
        "view_settings": {
          "rotation": 0.0,
          "zoom": 1.0,
          "wireframe": false
        }
      }
    },
    "audio_visualizer": {
      "input": {
        "device": "default",
        "sample_rate": 44100,
        "buffer_size": 1024,
        "fft_size": 2048
      },
      "pattern_mapping": {
        "frequency_scale": 0.5,
        "amplitude_scale": 1.0,
        "evolution_sensitivity": 0.75
      }
    },
    "memory_garden": {
      "layout": {
        "stm_radius": 10.0,
        "mtm_radius": 20.0,
        "ltm_radius": 30.0
      },
      "visualization": {
        "show_connections": true,
        "connection_opacity": 0.5,
        "pattern_scale": 1.0
      }
    }
  },
  "renderer": {
    "cycles": {
      "samples": 64,
      "denoising": true,
      "device": "gpu"
    }
  }
}